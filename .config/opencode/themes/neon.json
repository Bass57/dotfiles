{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "base0": "#0B1020",
    "base1": "#080D18",
    "base2": "#050912",
    "base3": "#141E30",
    "base4": "#1A2740",
    "base5": "#263851",
    "fg": "#E8EEF6",
    "fgDim": "#6F7D95",
    "fgMid": "#B7C6D6",
    "fgBright": "#F7FBFF",
    "muted": "#65718A",
    "neon": "#00E5FF",
    "neonBright": "#7AF5FF",
    "neonDim": "#00B8D6",
    "red": "#FF6B6B",
    "yellow": "#F4C95D",
    "orange": "#F2A65A",
    "green": "#9FE870",
    "greenBright": "#C6F36B",
    "cyan": "#55D8FF",
    "blue": "#4BA3C7",
    "magenta": "#B78CFF",
    "brown": "#7E4B2A"
  },
  "theme": {
    "primary": { "dark": "neon", "light": "neonDim" },
    "secondary": { "dark": "cyan", "light": "blue" },
    "accent": { "dark": "neon", "light": "neon" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yellow", "light": "yellow" },
    "success": { "dark": "green", "light": "green" },
    "info": { "dark": "neon", "light": "neonDim" },
    "text": { "dark": "fg", "light": "base0" },
    "textMuted": { "dark": "muted", "light": "fgDim" },
    "background": { "dark": "base0", "light": "fg" },
    "backgroundPanel": { "dark": "base1", "light": "fgMid" },
    "backgroundElement": { "dark": "base3", "light": "fgBright" },
    "border": { "dark": "base5", "light": "base4" },
    "borderActive": { "dark": "neon", "light": "neonDim" },
    "borderSubtle": { "dark": "base4", "light": "fgMid" },
    "diffAdded": { "dark": "green", "light": "green" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "fgDim", "light": "fgDim" },
    "diffHunkHeader": { "dark": "neonDim", "light": "neon" },
    "diffHighlightAdded": { "dark": "greenBright", "light": "green" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "#0E1810", "light": "#E5F5E0" },
    "diffRemovedBg": { "dark": "#1C0E14", "light": "#F8E4E4" },
    "diffContextBg": { "dark": "base1", "light": "fg" },
    "diffLineNumber": { "dark": "fgDim", "light": "fgDim" },
    "diffAddedLineNumberBg": { "dark": "base2", "light": "#DDF0D8" },
    "diffRemovedLineNumberBg": { "dark": "base2", "light": "#F6DFDF" },
    "markdownText": { "dark": "fg", "light": "base0" },
    "markdownHeading": { "dark": "neon", "light": "neonDim" },
    "markdownLink": { "dark": "neonDim", "light": "neon" },
    "markdownLinkText": { "dark": "cyan", "light": "blue" },
    "markdownCode": { "dark": "greenBright", "light": "green" },
    "markdownBlockQuote": { "dark": "muted", "light": "fgDim" },
    "markdownEmph": { "dark": "magenta", "light": "magenta" },
    "markdownStrong": { "dark": "yellow", "light": "yellow" },
    "markdownHorizontalRule": { "dark": "base5", "light": "base4" },
    "markdownListItem": { "dark": "neon", "light": "neonDim" },
    "markdownListEnumeration": { "dark": "cyan", "light": "blue" },
    "markdownImage": { "dark": "magenta", "light": "magenta" },
    "markdownImageText": { "dark": "cyan", "light": "blue" },
    "markdownCodeBlock": { "dark": "fg", "light": "base0" },
    "syntaxComment": { "dark": "muted", "light": "fgDim" },
    "syntaxKeyword": { "dark": "magenta", "light": "magenta" },
    "syntaxFunction": { "dark": "neon", "light": "neonDim" },
    "syntaxVariable": { "dark": "fgMid", "light": "base0" },
    "syntaxString": { "dark": "green", "light": "green" },
    "syntaxNumber": { "dark": "orange", "light": "orange" },
    "syntaxType": { "dark": "cyan", "light": "blue" },
    "syntaxOperator": { "dark": "neonDim", "light": "neon" },
    "syntaxPunctuation": { "dark": "fg", "light": "base0" }
  }
}